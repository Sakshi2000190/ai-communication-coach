rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'collegeOrCompany', 'targetRole', 'role', 'currentStreak', 'highestStreak', 'totalPractices', 'lastPracticedAt', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ['user', 'admin']
        && (!('collegeOrCompany' in data) || (data.collegeOrCompany is string && data.collegeOrCompany.size() <= 150))
        && (!('targetRole' in data) || (data.targetRole is string && data.targetRole.size() <= 100))
        && (!('currentStreak' in data) || (data.currentStreak is number && data.currentStreak >= 0))
        && (!('highestStreak' in data) || (data.highestStreak is number && data.highestStreak >= 0))
        && (!('totalPractices' in data) || (data.totalPractices is number && data.totalPractices >= 0));
    }

    // Validation helper for PracticeStat
    function isValidPracticeStat(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'topicTitle', 'score', 'wpm', 'fillerCount', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'topicId', 'topicTitle', 'category', 'mode', 'score', 'wpm', 'fillerCount', 'fillerRatePerMin', 'wordCount', 'durationSeconds', 'primaryIssue', 'postureScore', 'gestureStatus', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.topicTitle is string && data.topicTitle.size() <= 200
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.wpm is number && data.wpm >= 0 && data.wpm <= 500
        && data.fillerCount is number && data.fillerCount >= 0
        && (!('topicId' in data) || (data.topicId is string && data.topicId.size() <= 100))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('mode' in data) || data.mode in ['video', 'audio'])
        && (!('fillerRatePerMin' in data) || (data.fillerRatePerMin is number && data.fillerRatePerMin >= 0))
        && (!('wordCount' in data) || (data.wordCount is number && data.wordCount >= 0))
        && (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0))
        && (!('primaryIssue' in data) || (data.primaryIssue is string && data.primaryIssue.size() <= 100))
        && (!('postureScore' in data) || (data.postureScore is number && data.postureScore >= 0 && data.postureScore <= 1))
        && (!('gestureStatus' in data) || (data.gestureStatus is string && data.gestureStatus.size() <= 50));
    }

    // Users Collection - PII protected, role assignment gated
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // On creation, non-admins cannot assign themselves role: 'admin'
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (incoming().role == 'user' || isAdmin())
        && incoming().createdAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          (isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().role == existing().role // Users cannot escalate own role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'collegeOrCompany', 'targetRole', 'currentStreak', 'highestStreak', 'totalPractices', 'lastPracticedAt', 'updatedAt']))
          || isAdmin()
        );

      allow delete: if isAdmin();

      // Practice Statistics Subcollection (No audio/video or transcripts stored)
      match /practice_stats/{statId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isOwner(userId)
          && isValidId(statId)
          && isValidPracticeStat(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if false; // Practice records are immutable historical logs
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Admins Collection - strictly gated
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
